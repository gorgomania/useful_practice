<% flash.each do |type, msg| %>
  <div class="px-3 <%= local_assigns[:height] || "h-16" %> border rounded-lg flex items-center justify-center text-center <%= type == "alert" ? "border-[#910a0a] text-[#910a0a] bg-[#e7a0a0]" : "border-[#0a9130] text-[#0a9130] bg-[#a0e7b1]" %>">
    <%= msg %>
  </div>
<% end %>
