<div class="auth_container">
  <div class="auth_window"  id = "auth_form">
      <div class="auth_content">
          <div class="auth_top">
              <span>Редактирование задачи</span>
          </div>

          <% flash.each do |type, msg| %>
            <div class = "auth_error">
                <%= msg %>
            </div>
          <% end %>

          <%= form_for(:tasks, url: project_task_path(@project_id, @task), html: { method: :patch }) do |f| %>
            <div class="field">
                <%= f.label "Имя", class: "auth_label" %>
                <%= f.text_field :name, class: "auth_input", autofocus: true, autocomplete: "name", value: @name%>
            </div>

            <%= f.select :state, @options, {}, {class: "task_status_select"}%>

            <div class="actions">
                <%= f.submit "Обновить", class:  "auth_press" %>
            </div>
          <% end %>

          <%= link_to "Назад", project_path(@project_id), class: "auth_link" %>
            
      </div>
  </div>
</div>