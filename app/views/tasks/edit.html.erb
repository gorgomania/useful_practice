<div class = "flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 gap-5 bg-white rounded-xl">
    <h1 class = "text-2xl text-[#333] font-bold text-center">Изменение задачи</h1>

    <% flash.each do |type, msg| %>
      <div class = "px-3 h-16 border border-[#910a0a] text-[#910a0a] bg-[#e7a0a0] rounded-lg flex items-center justify-center text-center">
        <%= msg %>
      </div>
    <% end %>

    <%= form_for(:tasks, url: project_task_path(@project, @task), html: { method: :patch, class: "flex flex-col gap-5" }) do |f| %>
      <%= render "shared/floating_field", f: f, attribute: :name, label_text: "Имя", options: { autofocus: true, autocomplete: "name", value: @name } %>

      <%= f.select :state, @options, {}, {class: "w-full p-3 text-base text-[#333] border border-[#e5e5e5] rounded-lg appearance-none bg-[#f2f2f2] bg-[url('/select.png')] bg-[length:12px] bg-[right_10px_center] bg-no-repeat hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]"} %>

      <div class="actions">
        <%= f.submit "Обновить", class: "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]" %>
  </div>
</div>