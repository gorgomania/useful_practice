<div class = "flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 gap-5 bg-white rounded-xl">
    <h1 class = "text-2xl text-[#333] font-bold text-center">Создание задачи</h1>

    <%= render "shared/flash" %>

    <%= form_for(:tasks, url: project_tasks_path(@project), html: { method: :post }) do |f| %>
      <%= render "shared/floating_field", f: f, attribute: :name, label_text: "Имя", options: { autocomplete: "name", value: @name } %>

      <div class="actions">
        <%= f.submit "Создать", class:  "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]" %>
  </div>
</div>