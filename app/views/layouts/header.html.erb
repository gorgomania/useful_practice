<header>
    <div class="header">
        <%= link_to projects_path, class: "logo_link" do %>
            <img src="http://localhost:3000/logo.jpg" id = "logo_img" alt="Logo">
        <%end%>
        <%= form_for(:projects, url: :projects, html: { method: :get }, class: "search_wrapper") do |f| %>
          <div class="field">
            <%= f.text_field :name, id: "search_input", autofocus: true, autocomplete: "name", value: @search_query, placeholder: "Поиск проектов" %>
          </div>
          <div class="actions search_button">
            <%= f.submit "Поиск", :type => :image, :src => "http://localhost:3000/search.png", class: "search_img" %>
          </div>
        <% end %>
        <div class="buttons">
            <%= link_to new_project_path do %>
                <img src="http://localhost:3000/create.png" alt="Create" class = "icon">
                <span>Создать проект</span>
            <%end%>
            <%= link_to projects_path do %>
                <img src="http://localhost:3000/projects.png" alt="Projects" class = "icon">
                <span>Мои проекты</span>
            <%end%>
            <%= link_to users_path do%>
                <img src="http://localhost:3000/profile.png" alt="Profile" class = "icon">
                <span>Профиль</span>
            <%end%>
        </div>
    </div>
</header>