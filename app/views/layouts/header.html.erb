<header class="flex px-19 py-4 items-center fixed w-full bg-white top-0">
  <%= link_to projects_path, class: "w-45 hover:opacity-90" do %>
    <%= image_tag "/logo.png" %>
  <%end%>

  <%= form_for(:projects, url: :projects, html: { method: :get }, class: "flex ml-12") do |f| %>
    <div class="field">
      <%= f.text_field :name, id: "search_input", class: "py-6 pl-3 pr-16 rounded-xl bg-[#f2f2f2] w-135 outline-none", autofocus: true, autocomplete: "name", value: @search_query, placeholder: "Поиск проектов" %>
    </div>

    <div class="actions w-0 h-0">
      <%= image_submit_tag("/search.png", name: "commit", id: "search_img", class: "relative right-12 top-5.5 rounded-xl w-7 h-7 hover:bg-[#f2f2f2] hover:shadow-[0_0_0_10px_#f2f2f2]", title: "Поиск") %>
    </div>
  <% end %>

  <div class="flex items-end ml-12">
    <%= link_to new_project_path, class: "p-2 flex flex-col justify-between items-center rounded-xl w-35 text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
      <%= image_tag "/create.png", class: "min-w-7 h-7 mb-1" %>
      <span>Создать проект</span>
    <%end%>

    <%= link_to projects_path, class: "ml-1 p-2 flex flex-col justify-between items-center rounded-xl w-35 text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
      <%= image_tag "/projects.png", class: "min-w-7 h-7 mb-1" %>
      <span>Мои проекты</span>
    <%end%>

    <%= link_to users_path, class: "ml-1 p-2 flex flex-col justify-between items-center rounded-xl w-35 text-[#4e4e4e] hover:bg-[#f2f2f2]" do%>
      <%= image_tag "/profile.png", class: "min-w-7 h-7 mb-1" %>
      <span>Профиль</span>
    <%end%>
  </div>
</header>