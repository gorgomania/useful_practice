<header>
    <div class="header" <%= "style = padding-right:90.675px" if @header_padding %>>
        <a href="/projects" class = "logo_link">
            <img src="http://localhost:3000/logo.jpg" id = "logo_img" alt="Logo">
        </a>
        <div class="search_wrapper">
            <input type="text" placeholder="Поиск проектов" id = "search_input" value = "<%= @value if @value %>">
            <button class="search_button">
                <img src="http://localhost:3000/search.png" class = "icon search_img" alt="Search">
            </button>
        </div>
        <div class="buttons">
            <%= link_to "/projects", class: "compare_link" do %>
                <img src="http://localhost:3000/projects.png" alt="Projects" class = "icon">
                <span>Мои проекты</span>
            <%end%>
            <%= link_to "/projects/new", class: "compare_link" do %>
                <img src="http://localhost:3000/create.png" alt="Create" class = "icon">
                <span>Создать проект</span>
            <%end%>
            <%= link_to "/users", class: "auth_button" do%>
                <img src="http://localhost:3000/profile.png" alt="Profile" class = "icon">
                <span>Профиль</span>
            <%end%>
        </div>
    </div>
</header>