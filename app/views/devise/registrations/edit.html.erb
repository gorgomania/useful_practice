<div class = "flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 gap-5 bg-white rounded-xl">
    <h1 class = "text-2xl text-[#333] font-bold text-center">Изменение профиля</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-5"}) do |f| %>
      <% resource.errors.full_messages.each do |msg| %>
        <div class = "px-3 h-16 border border-[#910a0a] text-[#910a0a] bg-[#e7a0a0] rounded-lg flex items-center justify-center text-center">
            <%= msg %>
        </div>
      <% end %>

      <%= render "shared/floating_field", f: f, attribute: :email, type: :email_field, options: { autofocus: true, autocomplete: "email" } %>
      <%= render "shared/floating_field", f: f, attribute: :password, type: :password_field, label_text: "Новый пароль", options: { autocomplete: "new-password" } %>
      <%= render "shared/floating_field", f: f, attribute: :password_confirmation, type: :password_field, label_text: "Подтверждение пароля", options: { autocomplete: "new-password" } %>
      <%= render "shared/floating_field", f: f, attribute: :current_password, type: :password_field, label_text: "Текущий пароль", options: { autocomplete: "current-password" } %>

      <div class="actions">
        <%= f.submit "Обновить", class: "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]"%>
        
  </div>
</div>
