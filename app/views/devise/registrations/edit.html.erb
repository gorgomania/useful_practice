<div class="auth_container">
  <div class="auth_window"  id = "auth_form">
      <div class="auth_content">
          <div class="auth_top">
              <span>Редактирование</span>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <% flash.each do |type, msg| %>
              <div class = "auth_error">
                  <%= msg %>
              </div>
            <% end %>

          <div class="field">
            <%= f.label :email, class: "auth_label" %>
            <%= f.email_field :email, class: "auth_input", autofocus: true, autocomplete: "email" %>
          </div>

          <div class="field">
            <%= f.label "Новый пароль", class: "auth_label" %>
            <%= f.password_field :password, class: "auth_input", autocomplete: "new-password" %>
          </div>

          <div class="field">
            <%= f.label "Подтверждение пароля", class: "auth_label" %>
            <%= f.password_field :password_confirmation, class: "auth_input", autocomplete: "new-password" %>
          </div>

          <div class="field">
            <%= f.label "Текущий пароль", class: "auth_label" %>
            <%= f.password_field :current_password, class: "auth_input", autocomplete: "current-password" %>
          </div>

          <div class="actions">
            <%= f.submit "Обновить", class:  "auth_press" %>
          </div>
          <% end %>

          <%= link_to "Назад", :back, class: "auth_link"%>
            
      </div>
  </div>
</div>
