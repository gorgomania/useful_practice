<div class="auth_container">
    <div class="auth_window"  id = "reg_form">
        <div class="auth_content">
            <div class="auth_top">
                <span>Регистрация</span>
            </div>

            <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
              <% flash.each do |type, msg| %>
                <div class = "auth_error">
                    <%= msg %>
                </div>
              <% end %>

            <div class="field">
              <%= f.label :email, class: "auth_label" %>
              <%= f.email_field :email, class: "auth_input", id: "reg_email", autofocus: true, autocomplete: "email" %>
            </div>

            <div class="field">
              <%= f.label "Пароль", class: "auth_label"%>
              <%= f.password_field :password, class: "auth_input", id: "reg_pass", autocomplete: "new-password" %>
            </div>

            <div class="field">
              <%= f.label "Подтверждение пароля", class: "auth_label" %>
              <%= f.password_field :password_confirmation, class: "auth_input", id: "reg_pass_reg", autocomplete: "new-password" %>
            </div>

            <div class="actions">
              <%= f.submit "Зарегистрироваться", class: "auth_press" %>
            </div>
          <% end %>

          <%= render "devise/shared/links" %>

        </div>
    </div>
</div>