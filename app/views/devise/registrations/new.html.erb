<div class = "flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 gap-5 bg-white rounded-xl">
    <h1 class = "text-2xl text-[#333] font-bold text-center">Регистрация</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col gap-5" }) do |f| %>
      <% resource.errors.full_messages.each do |msg| %>
        <div class = "px-3 h-16 border border-[#910a0a] text-[#910a0a] bg-[#e7a0a0] rounded-lg flex items-center justify-center text-center">
            <%= msg %>
        </div>
      <% end %>

      <%= render "shared/floating_field", f: f, attribute: :email, type: :email_field, options: { autofocus: true, autocomplete: "email" } %>
      <%= render "shared/floating_field", f: f, attribute: :password, type: :password_field, label_text: "Пароль", options: { autocomplete: "new-password" } %>
      <%= render "shared/floating_field", f: f, attribute: :password_confirmation, type: :password_field, label_text: "Подтверждение пароля", options: { autocomplete: "new-password" } %>

      <div class="actions">
        <%= f.submit "Зарегистрироваться", class: "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>