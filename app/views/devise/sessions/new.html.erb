<div class = "flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 bg-white rounded-xl">
    <h1 class = "text-2xl text-[#333] font-bold text-center">Аутентификация</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <% flash.each do |type, msg| %>
        <div class = "mt-5 px-3 h-16 border border-[#910a0a] text-[#910a0a] bg-[#e7a0a0] rounded-lg flex items-center justify-center text-center">
            <%= msg %>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :email, class: "auth_label relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>

        <%= f.email_field :email, class: "auth_input w-full px-3 rounded-lg border border-[#e5e5e5] h-16 bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label "Пароль", class: "auth_label relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4"%>

        <%= f.password_field :password, class: "auth_input w-full px-3 rounded-lg border border-[#e5e5e5] h-16 bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field flex items-center mt-5 leading-4">
          <%= f.check_box :remember_me, class: "accent-[#fc5808] w-4 h-4 cursor-pointer"%>

          <%= f.label "Запомнить", class: "cursor-pointer pl-1", id: "auth_checkbox_label"%>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Войти", class: "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>