<div class = "flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 gap-5 bg-white rounded-xl">
    <h1 class = "text-2xl text-[#333] font-bold text-center">Аутентификация</h1>

    <% flash.each do |type, msg| %>
      <div class = "px-3 h-16 border border-[#910a0a] text-[#910a0a] bg-[#e7a0a0] rounded-lg flex items-center justify-center text-center">
          <%= msg %>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-5" }) do |f| %>

      <%= render "shared/floating_field", f: f, attribute: :email, type: :email_field, options: { autofocus: true, autocomplete: "email" } %>
      <%= render "shared/floating_field", f: f, attribute: :password, type: :password_field, label_text: "Пароль", options: { autocomplete: "current-password" } %>

      <% if devise_mapping.rememberable? %>
        <div class="field flex items-center leading-4">
          <%= f.check_box :remember_me, class: "accent-[#fc5808] w-4 h-4 cursor-pointer"%>

          <%= f.label "Запомнить", class: "cursor-pointer pl-1", id: "auth_checkbox_label"%>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Войти", class: "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>