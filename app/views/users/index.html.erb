<%= render template: "layouts/header"%>

<main class = "flex flex-col mt-26 px-19 py-5 gap-2">
  <h1 class = "text-3xl font-bold text-[#333]">
    Профиль 
  </h1>

  <div>
    <h2 class = "text-[#fc5808] font-medium">
      Email
    </h2>

    <span> 
      <%= current_user.email %>
    </span>
  </div>

  <%= button_to 'Выйти из аккаунта', destroy_user_session_path, :method => :delete, class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]" %>
  <%= button_to 'Редактировать профиль', edit_user_registration_path, :method => :get, class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]" %>
  <%= button_to "Удалить аккаунт", registration_path(:user), data: { turbo_confirm: "Вы уверены?" }, method: :delete, class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]" %>
</main>