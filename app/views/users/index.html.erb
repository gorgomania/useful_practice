<body>
    <%= render template: "layouts/header"%>
    <main class = "user_container">
        <h1>
            Профиль 
        </h1>
        <h2>
            Email
        </h2>
        <span> 
            <%= current_user.email %>
        </span>
        <%= button_to 'Выйти из аккаунта', destroy_user_session_path, :method => :delete, class: "auth_link"%>
        <%= button_to 'Редактировать профиль', edit_user_registration_path, :method => :get, class: "auth_link"%>
        <%= button_to "Удалить аккаунт", registration_path(:user), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "auth_link"%>
    </main>
</body>