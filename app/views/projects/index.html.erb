<body>
    <%= render template: "layouts/header"%>
    <main class = "user_container">
        <% if @search_query %>
            <h1> Результаты поиска </h1>
        <% else %>
            <h1> Мои проекты </h1>
        <% end %>
        <% flash.each do |type, msg| %>
            <div class = <%= type == "alert" ? :project_error : :project_success%>>
                <%= msg %>
            </div>
        <% end %>
        <%if @projects != []%>
            <div class="projects_list">
                <% @projects.each do |project| %>
                    <div class="project_card" id = "card<%= project.id %>">
                        <%= link_to project.name, project_path(project), class: "project_name" %>
                        <% if project.goal && project.goal != "" %>
                            <h2> Цель </h2>
                            <span style="text-align:justify">
                                <%= project.goal %>
                            </span>
                        <% end %>
                        <% if project.description && project.description != "" %>
                            <h2> Описание </h2>
                            <span style="text-align:justify">
                                <%= project.description %>
                            </span>
                        <% end %>
                    </div>
                <% end %>
            </div>
        <%else%>
            <% if @search_query%>
                <h2> По результатам поискового запроса "<%=@search_query%>" ничего не найдено. </h2>
            <% else %>
                <h2> У вас пока нет проектов. </h2>
            <% end %>
        <%end%>
    </main>
</body>