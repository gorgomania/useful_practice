<%= render template: "layouts/header"%>

<main class = "mt-26 px-19 py-5">
  <div class = "flex gap-5">
    <% if @search_query %>
      <h1 class = "text-3xl font-bold text-[#333]"> Результаты поиска </h1>
    <% else %>
      <h1 class = "text-3xl font-bold text-[#333]"> Мои проекты </h1>
    <% end %>

    <% flash.each do |type, msg| %>
      <div class = "px-3 h-9 border rounded-lg flex items-center justify-center <%= type == "alert" ? "border-[#910a0a] text-[#910a0a] bg-[#e7a0a0]" : "border-[#0a9130] text-[#0a9130] bg-[#a0e7b1]" %> ">
        <%= msg %>
      </div>
    <% end %>
  </div>

  <% if @projects != [] %>
    <div class="mt-5 grid grid-cols-4 gap-[10px] text-[#333]">
      <% @projects.each do |project| %>
        <div class="flex flex-col p-3 rounded-xl bg-white">
          <div class = "flex justify-end gap-1">
            <%= button_to edit_project_path(project), method: :get, class: "cursor-pointer rounded-lg ml-1 p-2 bg-white hover:bg-[#f2f2f2]" do %>
              <%= image_tag "/pencil.png", class: "w-4 h-4" %>
            <%end%>

            <%= button_to project_path(project), data: { turbo_confirm: "Вы уверены?" }, method: :delete, class: "cursor-pointer rounded-lg ml-1 p-2 bg-white hover:bg-[#f2f2f2]" do %>
              <%= image_tag "/trash.png", class: "w-4 h-4" %>
            <%end%>
          </div>

          <div class = "flex flex-col gap-2" >
            <%= link_to project.name, project_path(project), class: "text-2xl font-bold leading-6 hover:text-[#fc5808]" %>

            <div>
              <h2 class = "text-[#fc5808] font-medium"> Цель </h2>
              
              <span class="text-justify">
                <% if project.goal.present? %>
                  <%= project.goal %>
                <% else %>
                  <%= "---" %>
                <% end %>
              </span>
            </div>

            <div>
              <h2 class = "text-[#fc5808] font-medium"> Описание </h2>

              <span class = "text-justify">
                <% if project.description.present? %>
                  <%= project.description %>
                <% else %>
                  <%= "---" %>
                <% end %>
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <%else%>
    <div class = "mt-2 text-[#fc5808]">
      <% if @search_query%>
        <h2> По результатам поискового запроса "<%=@search_query%>" ничего не найдено. </h2>
      <% else %>
        <h2> У вас пока нет проектов. </h2>
      <% end %>
    </div>
  <%end%>
</main>