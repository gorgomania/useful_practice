<%= render template: "layouts/header"%>

<main class = "mt-26 px-19 py-5">
  <div class = "flex gap-5" >
    <h1 class = "text-3xl font-bold text-[#333]">
      <%= @project.name %>
    </h1>

    <% flash.each do |type, msg| %>
      <div class = "px-3 h-9 border rounded-lg flex items-center justify-center <%= type == "alert" ? "border-[#910a0a] text-[#910a0a] bg-[#e7a0a0]" : "border-[#0a9130] text-[#0a9130] bg-[#a0e7b1]" %>">
        <%= msg %>
      </div>
    <% end %>
  </div>

  <%= link_to "Новая задача", new_project_task_path(@project), class: "h-10 w-44 bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded mt-5 flex items-center justify-center hover:opacity-90" %>
    
  <%if @tasks != []%>
    <div class="mt-5 grid grid-cols-5 gap-[10px] text-[#333]">
      <% @states.each do |state|%>
        <h2 class = "text-center font-bold text-xl p-5 bg-white rounded-xl"> <%= state %> </h2>
      <%end%>

      <% @tasks.each do |task| %>
        <%if task %>
          <div class="bg-white rounded-xl p-3">
            <div class = "flex justify-end gap-1">
              <%= button_to edit_project_task_path(@project, task), method: :get, class: "cursor-pointer rounded-lg ml-1 p-2 bg-white hover:bg-[#f2f2f2]" do %>
                <%= image_tag "/pencil.png", class: "w-4 h-4" %>
              <%end%>

              <%= button_to project_task_path(@project, task), data: { turbo_confirm: "Вы уверены?" }, method: :delete, class: "cursor-pointer rounded-lg ml-1 p-2 bg-white hover:bg-[#f2f2f2]" do %>
                <%= image_tag "/trash.png", class: "w-4 h-4" %>
              <%end%>
            </div>
            
            <span class = "text-left text-2xl font-medium leading-6 "><%= task.name%></span>
          </div>
        <% else %>
          <div></div>
        <% end %>
      <% end %>
    </div>
  <%else%>
    <h2 class = "mt-2 text-[#fc5808]"> В данном проекте задачи отсутствуют. </h2>
  <%end%>
</main>