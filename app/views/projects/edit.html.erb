<div class = "flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 gap-5 bg-white rounded-xl">
    <h1 class = "text-2xl text-[#333] font-bold text-center">Изменение проекта</h1>

    <% flash.each do |type, msg| %>
      <div class = "px-3 h-16 border border-[#910a0a] text-[#910a0a] bg-[#e7a0a0] rounded-lg flex items-center justify-center text-center">
        <%= msg %>
      </div>
    <% end %>

    <%= form_for(:projects, url: project_path(@project), html: { method: :patch, class: "flex flex-col gap-5" }) do |f| %>
      <%= render "shared/floating_field", f: f, attribute: :name, label_text: "Имя", options: { autofocus: true, autocomplete: "name", value: @project.name } %>
      <%= render "shared/floating_field", f: f, attribute: :goal, label_text: "Цель", options: { value: @project.goal } %>
      <%= render "shared/floating_field", f: f, attribute: :description, label_text: "Описание", options: { value: @project.description } %>

      <div class="actions">
        <%= f.submit "Обновить", class: "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]" %>
  </div>
</div>