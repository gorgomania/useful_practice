<div class="flex justify-center">
  <div class="flex flex-col my-26 w-80 p-5 gap-5 bg-white rounded-xl">
    <h1 class="text-2xl text-[#333] font-bold text-center"><%= title %></h1>

    <%= render "shared/flash" %>

    <%= form_for(:projects, url: url, html: { method: method, class: "flex flex-col gap-5" }) do |f| %>
      <%= render "shared/floating_field", f: f, attribute: :name, label_text: "Имя", options: { autocomplete: "name", value: @project.name } %>
      <%= render "shared/floating_field", f: f, attribute: :goal, label_text: "Цель", options: { value: @project.goal } %>
      <%= render "shared/floating_field", f: f, attribute: :description, label_text: "Описание", options: { value: @project.description } %>

      <div class="actions">
        <%= f.submit submit_text, class: "h-16 w-full bg-gradient-to-t from-[#fc8507] to-[#ffa218] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 cursor-pointer flex justify-center hover:text-[#fc5808]" %>
  </div>
</div>
